{
  "name": "woe",
  "version": "1.3.8",
  "description": "Gotify-compatible notification service",
  "main": "src/index.ts",
  "scripts": {
    "postinstall": "node scripts/plugins/generate.mjs && node scripts/write-build-info.js",
    "wrangler": "node scripts/plugins/wrangler.mjs",
    "build:metadata": "node scripts/write-build-info.js",
    "predev": "node scripts/plugins/generate.mjs",
    "dev": "npm run build:metadata && npm run wrangler -- dev",
    "watch": "node scripts/plugins/watch.mjs",
    "predeploy": "node scripts/plugins/generate.mjs",
    "deploy": "npm run build:metadata && npm run wrangler -- deploy",
    "prebuild": "node scripts/plugins/generate.mjs",
    "build": "npm run build:frontend && npm run wrangler -- deploy --dry-run",
    "prebuild:frontend": "node scripts/plugins/generate.mjs",
    "build:frontend": "npm run build:metadata && cd frontend && npm run build",
    "dev:frontend": "cd frontend && npm run dev",
    "setup:frontend": "cd frontend && npm install",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:update-index": "node scripts/update-migration-index.js",
    "pretest:frontend": "node scripts/plugins/generate.mjs",
    "test:frontend": "cd frontend && npx vitest run",
    "pretest:i18n": "node scripts/plugins/generate.mjs",
    "test:i18n": "node --test frontend/tests/i18n-coverage.test.mjs",
    "test:plugins": "node --test scripts/plugins/discovery.test.mjs scripts/plugins/generate.test.mjs scripts/plugins/checkBoundaries.test.mjs scripts/plugins/projectDependencies.test.mjs scripts/plugins/resourceConfig.test.mjs scripts/plugins/wrangler.test.mjs scripts/plugins/export.test.mjs scripts/plugins/watch.test.mjs",
    "test:fast": "npx jest --onlyChanged --passWithNoTests --runInBand && cd frontend && npx vitest run --changed --passWithNoTests",
    "plugin:test": "node scripts/plugins/testPackage.mjs",
    "plugin:map": "node scripts/plugins/pluginMap.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.8",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.6.3",
    "wrangler": "^4.136.1"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.2.0",
    "drizzle-orm": "^0.45.0",
    "file-type": "^21.3.0",
    "hono": "^4.11.4",
    "yaml": "^2.7.0"
  }
}
