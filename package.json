{
  "name": "woe",
  "version": "1.3.6",
  "description": "Gotify-compatible notification service",
  "main": "src/index.ts",
  "scripts": {
    "build:metadata": "node scripts/write-build-info.js",
    "dev": "npm run build:metadata && wrangler dev",
    "deploy": "npm run build:metadata && wrangler deploy",
    "build": "npm run build:frontend && wrangler deploy --dry-run",
    "build:frontend": "npm run build:metadata && cd frontend && npm run build",
    "dev:frontend": "cd frontend && npm run dev",
    "setup:frontend": "cd frontend && npm install",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:update-index": "node scripts/update-migration-index.js",
    "test:frontend": "cd frontend && npx vitest run",
    "test:i18n": "node --test frontend/tests/i18n-coverage.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.8",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.6.3",
    "wrangler": "^4.136.1"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.2.0",
    "drizzle-orm": "^0.45.0",
    "file-type": "^21.3.0",
    "hono": "^4.11.4",
    "yaml": "^2.7.0"
  }
}
