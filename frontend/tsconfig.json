{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "*": ["./node_modules/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "../src/plugins/builtin/*/frontend/**/*.ts",
    "../src/plugins/builtin/*/frontend/**/*.vue",
    "../src/plugins/builtin/*/tests/frontend/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.tmp-*",
    "**/*.backup-*",
    "**/.plugin-tmp/**/*",
    "src/generated/plugins.tmp-*",
    "src/generated/plugins.backup-*",
    "../src/plugins/builtin/**/*.tmp-*",
    "../src/plugins/builtin/**/*.backup-*",
    "../src/plugins/builtin/**/.plugin-tmp/**/*"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
